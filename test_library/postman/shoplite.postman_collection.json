      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200',()=>pm.response.to.have.status(200));",
              "pm.test('at least 6 products',()=>pm.expect(pm.response.json().length).to.be.at.least(6));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get product 1",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
