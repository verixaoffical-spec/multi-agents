        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201',()=>pm.response.to.have.status(201));",
              "pm.test('order is PLACED',()=>pm.expect(pm.response.json().status).to.eql('PLACED'));",
              "pm.collectionVariables.set('stockProbe','done');"
            ]
          }
        }
      ]
    },
