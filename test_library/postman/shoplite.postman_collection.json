        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201',()=>pm.response.to.have.status(201));",
              "pm.test('subtotal is 2 x 799',()=>pm.expect(pm.response.json().subtotal).to.be.at.least(1598));"
            ]
          }
        }
      ]
    },
