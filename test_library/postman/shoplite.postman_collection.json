        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200',()=>pm.response.to.have.status(200));",
              "pm.test('price is 2499 cents',()=>pm.expect(pm.response.json().price).to.eql(2499));"
            ]
          }
        }
      ]
    },
