GROQ_API_KEY=your_groq_key
GITHUB_TOKEN=ghp_your_token
GITHUB_WEBHOOK_SECRET=any_long_random_string

# Neon PostgreSQL. Use the POOLED connection string (host contains -pooler), keep sslmode=require.
# Without it, runs and drafts are kept in memory only.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Test and execution agent
STAGING_URL=http://localhost:3000          # where the Shoplite staging app runs
# TEST_LIBRARY_DIR=test_library
OPENROUTER_API_KEY=your_openrouter_key     # Qwen3 Coder / Qwen3 8B / DeepSeek V4
# GEMINI_API_KEY=your_gemini_key           # last fallback, sample repos only

# Model chains (comma separated, tried in order). Defaults follow the priority table.
# SELECT_MODELS=groq/openai/gpt-oss-20b,openrouter/qwen/qwen3-8b,groq/openai/gpt-oss-120b
# CLASSIFY_MODELS=groq/openai/gpt-oss-20b,openrouter/qwen/qwen3-8b,groq/openai/gpt-oss-120b
# DRAFT_MODELS=openrouter/qwen/qwen3-coder,groq/openai/gpt-oss-120b,openrouter/deepseek/deepseek-v4

# Analysis agent chain. Models without a key are skipped. Do not set GEMINI_API_KEY if real
# repository code must not be sent to Gemini (its free tier may train on inputs).
# ANALYSIS_MODELS=groq/openai/gpt-oss-20b,groq/openai/gpt-oss-120b,openrouter/qwen/qwen3-8b

# Extra words that mark code as sensitive for risk scoring (comma separated)
# HIGH_RISK_KEYWORDS=ledger,kyc
# MEDIUM_RISK_KEYWORDS=report,export
